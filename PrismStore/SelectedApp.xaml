<Page
    x:Class="PrismStore.SelectedApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PrismStore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppHeaderBg" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="AppCardBg" Color="#262626" />
                    <SolidColorBrush x:Key="AppCardBorder" Color="#3D3D3D" />
                    <SolidColorBrush x:Key="AppHeroBg" Color="#103F66" />
                    <SolidColorBrush x:Key="AppTagBg" Color="#383838" />
                    <SolidColorBrush x:Key="AppAccent" Color="#0078D7" />
                    <SolidColorBrush x:Key="AppTextPrimary" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppTextSecondary" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="AppTextMuted" Color="#8A8A8A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppHeaderBg" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="AppCardBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppCardBorder" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="AppHeroBg" Color="#CCE4F7" />
                    <SolidColorBrush x:Key="AppTagBg" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="AppAccent" Color="#005A9E" />
                    <SolidColorBrush x:Key="AppTextPrimary" Color="#000000" />
                    <SolidColorBrush x:Key="AppTextSecondary" Color="#505050" />
                    <SolidColorBrush x:Key="AppTextMuted" Color="#767676" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- ADAPTIVE VISUAL STATE MANAGER -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <!-- Mobile Screens (< 680px) -->
                <VisualState x:Name="MobileState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TopBarGrid.Padding" Value="16,0,8,0" />
                        <Setter Target="MainScrollViewer.Padding" Value="16,16,16,32" />

                        <!-- Stack Hero elements vertically -->
                        <Setter Target="HeroStackPanel.Orientation" Value="Vertical" />
                        <Setter Target="HeroDetailsPanel.Margin" Value="0,16,0,0" />

                        <!-- Stack Body details & metadata vertically -->
                        <Setter Target="BodySplitPanel.Orientation" Value="Vertical" />
                        <Setter Target="DetailsSection.Margin" Value="0,0,0,24" />
                        <Setter Target="MetadataSection.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Desktop Screens (>= 680px) -->
                <VisualState x:Name="DesktopState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="680" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TopBarGrid.Padding" Value="24,0,16,0" />
                        <Setter Target="MainScrollViewer.Padding" Value="32,24,32,40" />

                        <Setter Target="HeroStackPanel.Orientation" Value="Horizontal" />
                        <Setter Target="HeroDetailsPanel.Margin" Value="24,0,0,0" />

                        <Setter Target="BodySplitPanel.Orientation" Value="Horizontal" />
                        <Setter Target="DetailsSection.Margin" Value="0,0,32,0" />
                        <Setter Target="MetadataSection.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Grid x:Name="TopBarGrid" Grid.Row="0" Background="{ThemeResource AppHeaderBg}" Padding="24,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Product details" 
                       Grid.Column="0"
                       FontFamily="Segoe UI" 
                       FontWeight="Light" 
                       FontSize="20" 
                       Foreground="{ThemeResource AppTextPrimary}" 
                       VerticalAlignment="Center" />

            <Button x:Name="ShareButton" Grid.Column="1" Width="54" Height="54"
                    Background="Transparent" BorderThickness="0" Click="Share_Click">
                <FontIcon Glyph="&#xE72D;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource AppTextPrimary}" FontSize="16" />
            </Button>
        </Grid>

        <!-- Main Content Area -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" Padding="0">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

                <!-- SECTION 1: APP HERO HEADER -->
                <Grid x:Name="HeroSection" 
                      Margin="0,0,0,28" 
                      Opacity="0" 
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <CompositeTransform ScaleX="0.8" ScaleY="0.8" />
                    </Grid.RenderTransform>

                    <StackPanel x:Name="HeroStackPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- App Icon -->
                        <Border x:Name="HeroIconBorder" Width="120" Height="120" 
                                Background="{ThemeResource AppCardBg}" 
                                BorderBrush="{ThemeResource AppCardBorder}" BorderThickness="1"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Image Source="{Binding ImagePath}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Titles & Actions -->
                        <StackPanel x:Name="HeroDetailsPanel" Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Light" 
                                       FontSize="28" 
                                       Foreground="{ThemeResource AppTextPrimary}" 
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Text="{Binding Subtitle}" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Light" 
                                       FontSize="15" 
                                       Foreground="{ThemeResource AppTextSecondary}" 
                                       Margin="0,2,0,0" 
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding Publisher}" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Light" 
                                       FontSize="13" 
                                       Foreground="{ThemeResource AppAccent}" 
                                       Margin="0,4,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="DownloadButton" 
                                        Content="Get / Download" 
                                        Background="{ThemeResource AppAccent}" 
                                        Foreground="White" 
                                        FontFamily="Segoe UI" 
                                        FontWeight="Light" 
                                        Padding="20,6" 
                                        BorderThickness="0" 
                                        Click="InstantDownload_Click" />

                                <Button Content="•••" 
                                        Background="{ThemeResource AppCardBg}" 
                                        Foreground="{ThemeResource AppTextPrimary}" 
                                        BorderBrush="{ThemeResource AppCardBorder}"
                                        BorderThickness="1"
                                        Margin="8,0,0,0" 
                                        Padding="12,6">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem Text="Save As..." Click="SaveAs_Click" />
                                            <MenuFlyoutItem Text="Open in Browser" Click="OpenInBrowser_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>

                                <ProgressRing x:Name="DownloadProgressRing" 
                                              Width="24" 
                                              Height="24" 
                                              IsActive="False" 
                                              Visibility="Collapsed" 
                                              Margin="12,0,0,0" 
                                              Foreground="{ThemeResource AppAccent}" />
                            </StackPanel>

                            <StackPanel x:Name="DownloadProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                <TextBlock x:Name="DownloadStatusText" 
                                           Text="0 MB / 0 MB (0%)" 
                                           FontFamily="Segoe UI" 
                                           FontSize="12" 
                                           Foreground="{ThemeResource AppTextMuted}" 
                                           Margin="0,0,0,4" />
                                <ProgressBar x:Name="DownloadProgressBar" 
                                             Height="4" 
                                             Minimum="0" 
                                             Maximum="100" 
                                             Value="0" 
                                             Foreground="{ThemeResource AppAccent}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Rectangle Height="1" Fill="{ThemeResource AppCardBorder}" Margin="0,0,0,24" />

                <!-- SECTION 2 & 3: DETAILS AND METADATA -->
                <StackPanel x:Name="BodySplitPanel" Orientation="Horizontal" Margin="0,0,0,28">
                    <!-- Left: Description & Screenshots (Stagger 2) -->
                    <StackPanel x:Name="DetailsSection" 
                                Margin="0,0,32,0" 
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5"
                                MinWidth="280"
                                MaxWidth="720">
                        <StackPanel.RenderTransform>
                            <CompositeTransform ScaleX="0.8" ScaleY="0.8" />
                        </StackPanel.RenderTransform>

                        <TextBlock Text="Description" 
                                   FontFamily="Segoe UI" 
                                   FontWeight="Light" 
                                   FontSize="20" 
                                   Foreground="{ThemeResource AppTextPrimary}" 
                                   Margin="0,0,0,10" />

                        <TextBlock Text="{Binding Description}" 
                                   FontFamily="Segoe UI" 
                                   FontWeight="Light" 
                                   FontSize="14" 
                                   LineHeight="20" 
                                   TextWrapping="Wrap" 
                                   Foreground="{ThemeResource AppTextSecondary}" 
                                   Margin="0,0,0,18" />

                        <Border Background="{ThemeResource AppCardBg}" 
                                BorderBrush="{ThemeResource AppCardBorder}" 
                                BorderThickness="1" 
                                MaxHeight="380">
                            <Image Source="{Binding DetailImagePath}" Stretch="Uniform" />
                        </Border>
                    </StackPanel>

                    <!-- Right: Package Metadata Box (Stagger 3) -->
                    <Border x:Name="MetadataSection" 
                            Background="{ThemeResource AppCardBg}" 
                            BorderBrush="{ThemeResource AppCardBorder}" 
                            BorderThickness="1" 
                            Padding="16" 
                            VerticalAlignment="Top"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5"
                            MinWidth="260"
                            MaxWidth="320">
                        <Border.RenderTransform>
                            <CompositeTransform ScaleX="0.8" ScaleY="0.8" />
                        </Border.RenderTransform>

                        <StackPanel>
                            <TextBlock Text="Additional Information" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Light" 
                                       FontSize="16" 
                                       Foreground="{ThemeResource AppTextPrimary}" 
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Supported Platform" FontFamily="Segoe UI" FontSize="11" Foreground="{ThemeResource AppTextMuted}" />
                            <TextBlock Text="{Binding Framework}" FontFamily="Segoe UI" FontWeight="Light" FontSize="14" Foreground="{ThemeResource AppTextPrimary}" Margin="0,2,0,10" />

                            <TextBlock Text="Version" FontFamily="Segoe UI" FontSize="11" Foreground="{ThemeResource AppTextMuted}" />
                            <TextBlock Text="{Binding Version}" FontFamily="Segoe UI" FontWeight="Light" FontSize="14" Foreground="{ThemeResource AppTextPrimary}" Margin="0,2,0,10" />

                            <TextBlock Text="Category" FontFamily="Segoe UI" FontSize="11" Foreground="{ThemeResource AppTextMuted}" />
                            <TextBlock Text="{Binding Category}" FontFamily="Segoe UI" FontWeight="Light" FontSize="14" Foreground="{ThemeResource AppTextPrimary}" Margin="0,2,0,10" />

                            <TextBlock Text="Publisher" FontFamily="Segoe UI" FontSize="11" Foreground="{ThemeResource AppTextMuted}" />
                            <TextBlock Text="{Binding Publisher}" FontFamily="Segoe UI" FontWeight="Light" FontSize="14" Foreground="{ThemeResource AppTextPrimary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Rectangle Height="1" Fill="{ThemeResource AppCardBorder}" Margin="0,0,0,24" />

                <!-- SECTION 4: RATINGS & REVIEWS -->
                <StackPanel x:Name="ReviewsSection" 
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <CompositeTransform ScaleX="0.8" ScaleY="0.8" />
                    </StackPanel.RenderTransform>

                    <TextBlock Text="Ratings and reviews" 
                               FontFamily="Segoe UI" 
                               FontWeight="Light" 
                               FontSize="20" 
                               Foreground="{ThemeResource AppTextPrimary}" 
                               Margin="0,0,0,14" />

                    <!-- Rating Summary -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock x:Name="AverageRatingText" 
                                   Text="0.0" 
                                   FontFamily="Segoe UI" 
                                   FontWeight="Light" 
                                   FontSize="42" 
                                   Foreground="{ThemeResource AppAccent}" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Average rating" FontFamily="Segoe UI" FontSize="13" Foreground="{ThemeResource AppTextPrimary}" />
                            <TextBlock x:Name="ReviewCountText" Text="0 reviews" FontFamily="Segoe UI" FontSize="11" Foreground="{ThemeResource AppTextMuted}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Review Form -->
                    <StackPanel x:Name="ReviewFormPanel" Margin="0,0,0,20" MaxWidth="600" HorizontalAlignment="Stretch" Visibility="Collapsed">
                        <TextBox x:Name="ReviewCommentBox" 
                                 PlaceholderText="Write your review..." 
                                 AcceptsReturn="True" 
                                 Height="75" 
                                 TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ComboBox x:Name="ReviewRatingBox" Header="Rating" SelectedIndex="4" Width="90">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4" />
                                <ComboBoxItem Content="5" />
                            </ComboBox>

                            <Button Content="Submit Review" 
                                    Background="{ThemeResource AppAccent}" 
                                    Foreground="White" 
                                    FontFamily="Segoe UI" 
                                    FontWeight="Light" 
                                    BorderThickness="0" 
                                    Margin="14,24,0,0" 
                                    Click="SubmitReview_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Sign In Required Prompt -->
                    <Border x:Name="SignInToReviewPanel" 
                            Background="{ThemeResource AppCardBg}" 
                            BorderBrush="{ThemeResource AppCardBorder}" 
                            BorderThickness="1" 
                            Padding="14" 
                            Margin="0,0,0,20" 
                            MaxWidth="600" 
                            HorizontalAlignment="Stretch" 
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Sign in to write a review" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="SemiBold" 
                                       FontSize="14" 
                                       Foreground="{ThemeResource AppTextPrimary}" />
                            <TextBlock Text="You must be logged into your Prism Store account to post ratings and feedback." 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Light" 
                                       FontSize="12" 
                                       Foreground="{ThemeResource AppTextMuted}" 
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Responsive Reviews Grid (Wraps automatically on mobile/desktop) -->
                    <GridView x:Name="ReviewsGrid" 
                              SelectionMode="None" 
                              IsItemClickEnabled="False"
                              HorizontalAlignment="Stretch">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,12,12" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource AppCardBg}" 
                                        BorderBrush="{ThemeResource AppCardBorder}" 
                                        BorderThickness="1" 
                                        Padding="14" 
                                        Width="480"
                                        MinHeight="100"
                                        HorizontalAlignment="Stretch"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5"
                                        Loaded="ReviewCard_Loaded">
                                    <Border.RenderTransform>
                                        <CompositeTransform ScaleX="0.8" ScaleY="0.8" />
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding username}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AppTextPrimary}" />
                                            <TextBlock Text=" • " FontFamily="Segoe UI" FontSize="11" Foreground="{ThemeResource AppTextMuted}" Margin="4,0,4,0" />
                                            <TextBlock Text="{Binding updatedAt}" FontFamily="Segoe UI" FontSize="11" Foreground="{ThemeResource AppTextMuted}" />
                                        </StackPanel>

                                        <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="{ThemeResource AppAccent}" Margin="0,3,0,0">
                                            <Run Text="★ " /><Run Text="{Binding rating}" />
                                        </TextBlock>

                                        <TextBlock Text="{Binding comment}" FontFamily="Segoe UI" FontWeight="Light" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondary}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Pagination Controls -->
                    <StackPanel x:Name="PaginationPanel" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <Button x:Name="PrevPageButton" 
                                Content="Previous" 
                                Background="{ThemeResource AppCardBg}" 
                                BorderBrush="{ThemeResource AppCardBorder}"
                                BorderThickness="1"
                                FontFamily="Segoe UI" 
                                FontWeight="Light" 
                                Padding="12,5" 
                                Click="PrevPageButton_Click" />

                        <TextBlock x:Name="PageNumberText" 
                                   Text="Page 1 of 1" 
                                   FontFamily="Segoe UI" 
                                   FontWeight="Light" 
                                   FontSize="12" 
                                   Foreground="{ThemeResource AppTextSecondary}" 
                                   VerticalAlignment="Center" 
                                   Margin="14,0,14,0" />

                        <Button x:Name="NextPageButton" 
                                Content="Next" 
                                Background="{ThemeResource AppCardBg}" 
                                BorderBrush="{ThemeResource AppCardBorder}" 
                                BorderThickness="1"
                                FontFamily="Segoe UI" 
                                FontWeight="Light" 
                                Padding="12,5" 
                                Click="NextPageButton_Click" />
                    </StackPanel>

                    <!-- Empty State Notice -->
                    <TextBlock x:Name="EmptyStateText" 
                               Text="No reviews yet. Be the first to share feedback." 
                               FontFamily="Segoe UI" 
                               FontWeight="Light" 
                               FontSize="13" 
                               Foreground="{ThemeResource AppTextMuted}" 
                               Visibility="Collapsed" 
                               Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
