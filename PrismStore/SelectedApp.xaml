<Page
    x:Class="PrismStore.SelectedApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid x:Name="RootPageGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <VisualState x:Name="MobileState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainContentPanel.Margin" Value="16,16,16,32" />
                        <Setter Target="HeroStackPanel.Orientation" Value="Vertical" />
                        <Setter Target="HeroDetailsPanel.Margin" Value="0,16,0,0" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="DesktopState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="680" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainContentPanel.Margin" Value="32,24,32,40" />
                        <Setter Target="HeroStackPanel.Orientation" Value="Horizontal" />
                        <Setter Target="HeroDetailsPanel.Margin" Value="24,0,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TopBarGrid"
              Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
              Padding="0,0,138,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Width="48"
                    Height="48"
                    Background="Transparent"
                    Canvas.ZIndex="1"
                    Click="BackButton_Click">
                <SymbolIcon Symbol="Back" />
            </Button>

            <Grid x:Name="AppTitleBarDragRegion"
                  Grid.Column="1"
                  Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Image Source="ms-appx:///Assets/PrismStore.png" Width="36" Height="36" VerticalAlignment="Center" />
                    <TextBlock Text="Product details" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </Grid>

            <Button x:Name="ShareButton"
                    Grid.Column="2"
                    Width="48"
                    Height="48"
                    Background="Transparent"
                    Canvas.ZIndex="1"
                    Click="Share_Click">
                <FontIcon Glyph="&#xE72D;" FontFamily="Segoe MDL2 Assets" />
            </Button>
        </Grid>

        <!-- Main Content Area -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1">
            <StackPanel x:Name="MainContentPanel" MaxWidth="920" HorizontalAlignment="Left" Margin="32,24,32,40">

                <!-- SECTION 1: APP HERO HEADER -->
                <Grid x:Name="HeroSection" Margin="0,0,0,28" Opacity="0" HorizontalAlignment="Left">
                    <StackPanel x:Name="HeroStackPanel" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid Width="120"
              Height="120"
              Background="{ThemeResource SystemControlBackgroundAccentBrush}"
              VerticalAlignment="Top"
              HorizontalAlignment="Left">
                            <Image Source="{Binding ImagePath}" Stretch="UniformToFill" />
                        </Grid>

                        <StackPanel x:Name="HeroDetailsPanel" Margin="24,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource HeaderTextBlockStyle}" FontSize="28" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding Publisher}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Margin="0,3,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="DownloadButton" Content="Get / Download" Background="{ThemeResource SystemControlBackgroundAccentBrush}" Foreground="White" Click="InstantDownload_Click" />

                                <Button Content="•••" Margin="8,0,0,0">
                                    <Button.Flyout>
                                        <MenuFlyout x:Name="MoreActionsFlyout" Placement="Bottom">
                                            <MenuFlyoutItem x:Name="ForceUpdateMenuItem" Text="Force Update / Reinstall" Visibility="Collapsed" Click="ForceUpdate_Click" />
                                            <MenuFlyoutItem x:Name="UninstallMenuItem" Text="Uninstall" Visibility="Collapsed" Click="Uninstall_Click" />
                                            <MenuFlyoutSeparator x:Name="InstalledActionsSeparator" Visibility="Collapsed" />
                                            <MenuFlyoutItem Text="Save As..." Click="SaveAs_Click" />
                                            <MenuFlyoutItem Text="Open in Browser" Click="OpenInBrowser_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>

                                <ProgressRing x:Name="DownloadProgressRing" Width="24" Height="24" Visibility="Collapsed" Margin="12,0,0,0" />
                            </StackPanel>

                            <StackPanel x:Name="DownloadProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                <TextBlock x:Name="DownloadStatusText" Text="0 MB / 0 MB (0%)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,4" />
                                <ProgressBar x:Name="DownloadProgressBar" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Rectangle Height="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,0,0,24" />

                <!-- SECTION 2: DESCRIPTION & SCREENSHOT -->
                <StackPanel x:Name="DetailsSection" HorizontalAlignment="Left" Margin="0,0,0,28" Opacity="0">
                    <TextBlock Text="Description" Style="{StaticResource TitleTextBlockStyle}" FontSize="20" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}" Margin="0,0,0,18" MaxWidth="720" HorizontalAlignment="Left" />

                    <Image Source="{Binding DetailImagePath}" Stretch="Uniform" MaxHeight="440" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- SECTION 3: ADDITIONAL INFORMATION (UNDER DETAILS, NO BACKGROUND/BORDER) -->
                <StackPanel x:Name="MetadataSection" Margin="0,0,0,28" HorizontalAlignment="Left" Opacity="0">
                    <TextBlock Text="Additional information" Style="{StaticResource TitleTextBlockStyle}" FontSize="20" Margin="0,0,0,14" />

                    <Grid MaxWidth="480" MinWidth="360" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Supported Platform" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,32,10" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Framework}" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Right" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,32,10" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Version}" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Right" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Category" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,32,10" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Category}" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Right" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Publisher" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,32,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Publisher}" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <Rectangle Height="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,0,0,24" />

                <!-- SECTION 4: RATINGS & REVIEWS (NO BORDERS OR BACKGROUNDS) -->
                <StackPanel x:Name="ReviewsSection" Opacity="0" HorizontalAlignment="Left">
                    <TextBlock Text="Ratings and reviews" Style="{StaticResource TitleTextBlockStyle}" FontSize="20" Margin="0,0,0,16" />

                    <!-- Summary & 5-to-1 Breakdown Bars -->
                    <Grid Margin="0,0,0,24" MaxWidth="560" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Big Rating Score + Overall Stars -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="AverageRatingText" Text="0.0" FontSize="44" FontWeight="Light" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" LineHeight="44" />
                                <TextBlock Text="/ 5" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,0,6" VerticalAlignment="Bottom" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBlock x:Name="Star1" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Margin="0,0,3,0" />
                                <TextBlock x:Name="Star2" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Margin="0,0,3,0" />
                                <TextBlock x:Name="Star3" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Margin="0,0,3,0" />
                                <TextBlock x:Name="Star4" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Margin="0,0,3,0" />
                                <TextBlock x:Name="Star5" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                            </StackPanel>

                            <TextBlock x:Name="ReviewCountText" Text="0 reviews" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>

                        <!-- Right: 5-to-1 Star Distribution Bars -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="5 stars" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" Margin="0,2" />
                            <Grid Grid.Row="0" Grid.Column="1" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left" Width="140">
                                <Rectangle Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Height="8" Width="140" HorizontalAlignment="Left" />
                                <Rectangle x:Name="Bar5" Fill="{ThemeResource SystemControlBackgroundAccentBrush}" Height="8" Width="0" HorizontalAlignment="Left" />
                            </Grid>
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="Count5Text" Text="0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="4 stars" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" Margin="0,2" />
                            <Grid Grid.Row="1" Grid.Column="1" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left" Width="140">
                                <Rectangle Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Height="8" Width="140" HorizontalAlignment="Left" />
                                <Rectangle x:Name="Bar4" Fill="{ThemeResource SystemControlBackgroundAccentBrush}" Height="8" Width="0" HorizontalAlignment="Left" />
                            </Grid>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="Count4Text" Text="0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="3 stars" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" Margin="0,2" />
                            <Grid Grid.Row="2" Grid.Column="1" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left" Width="140">
                                <Rectangle Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Height="8" Width="140" HorizontalAlignment="Left" />
                                <Rectangle x:Name="Bar3" Fill="{ThemeResource SystemControlBackgroundAccentBrush}" Height="8" Width="0" HorizontalAlignment="Left" />
                            </Grid>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="Count3Text" Text="0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="2 stars" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" Margin="0,2" />
                            <Grid Grid.Row="3" Grid.Column="1" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left" Width="140">
                                <Rectangle Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Height="8" Width="140" HorizontalAlignment="Left" />
                                <Rectangle x:Name="Bar2" Fill="{ThemeResource SystemControlBackgroundAccentBrush}" Height="8" Width="0" HorizontalAlignment="Left" />
                            </Grid>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="Count2Text" Text="0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="1 star" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" Margin="0,2" />
                            <Grid Grid.Row="4" Grid.Column="1" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left" Width="140">
                                <Rectangle Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Height="8" Width="140" HorizontalAlignment="Left" />
                                <Rectangle x:Name="Bar1" Fill="{ThemeResource SystemControlBackgroundAccentBrush}" Height="8" Width="0" HorizontalAlignment="Left" />
                            </Grid>
                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="Count1Text" Text="0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <!-- Review Form (Borderless, Transparent) -->
                    <StackPanel x:Name="ReviewFormPanel" Margin="0,0,0,24" MaxWidth="560" HorizontalAlignment="Stretch" Visibility="Collapsed">
                        <TextBlock x:Name="WriteReviewTitle" Text="Write a review" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="InputStar1" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Margin="0,0,6,0" Tag="1" Tapped="RatingStar_Tapped" />
                            <TextBlock x:Name="InputStar2" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Margin="0,0,6,0" Tag="2" Tapped="RatingStar_Tapped" />
                            <TextBlock x:Name="InputStar3" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Margin="0,0,6,0" Tag="3" Tapped="RatingStar_Tapped" />
                            <TextBlock x:Name="InputStar4" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Margin="0,0,6,0" Tag="4" Tapped="RatingStar_Tapped" />
                            <TextBlock x:Name="InputStar5" Text="&#xE1CF;" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" Tag="5" Tapped="RatingStar_Tapped" />
                        </StackPanel>

                        <TextBox x:Name="ReviewCommentBox" PlaceholderText="Write your review..." AcceptsReturn="True" Height="75" TextWrapping="Wrap" />

                        <Button x:Name="SubmitReviewBtn" Content="Submit Review" Background="{ThemeResource SystemControlBackgroundAccentBrush}" Foreground="White" Margin="0,12,0,0" Click="SubmitReview_Click" />

                        <StackPanel x:Name="ExistingReviewActionsPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                            <Button x:Name="UpdateReviewBtn" Content="Update Review" Background="{ThemeResource SystemControlBackgroundAccentBrush}" Foreground="White" Margin="0,0,10,0" Click="SubmitReview_Click" />
                            <Button x:Name="DeleteReviewBtn" Content="Delete Review" Background="#D9534F" Foreground="White" Click="DeleteReview_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Sign In Required Notice (Borderless, Transparent) -->
                    <StackPanel x:Name="SignInToReviewPanel" Margin="0,0,0,24" MaxWidth="560" HorizontalAlignment="Stretch" Visibility="Collapsed">
                        <TextBlock Text="Sign in to write a review" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="You must be logged into your PrismStore account to post ratings and feedback." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Reviews ListView (Borderless, Transparent Items) -->
                    <ListView x:Name="ReviewsGrid"
          SelectionMode="None"
          IsItemClickEnabled="True"
          ItemClick="ReviewsGrid_ItemClick"
          MaxWidth="560"
          Padding="0"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent" MaxWidth="560" HorizontalAlignment="Stretch" Opacity="0" Loaded="ReviewCard_Loaded">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar Tile with Segoe MDL2 Icon Font Fallback -->
                                        <Grid Grid.Column="0"
                          Width="40"
                          Height="40"
                          Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0">
                                            <FontIcon Glyph="&#xE77B;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                                            <Image Stretch="UniformToFill" Width="40" Height="40">
                                                <Image.Source>
                                                    <BitmapImage UriSource="{Binding avatar}" />
                                                </Image.Source>
                                            </Image>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding username}" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" FontWeight="SemiBold">
                                <Run Text="★ " /><Run Text="{Binding rating}" />
                                                </TextBlock>
                                                <TextBlock Text=" • " Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0" />
                                                <TextBlock Text="{Binding updatedAt}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding comment}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Pagination Controls -->
                    <StackPanel x:Name="PaginationPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <Button x:Name="PrevPageButton" Content="Previous" Click="PrevPageButton_Click" />
                        <TextBlock x:Name="PageNumberText" Text="Page 1 of 1" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="14,0" />
                        <Button x:Name="NextPageButton" Content="Next" Click="NextPageButton_Click" />
                    </StackPanel>

                    <TextBlock x:Name="EmptyStateText" Text="No reviews yet. Be the first to share feedback." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Visibility="Collapsed" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>