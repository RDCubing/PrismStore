<Page
    x:Class="PrismStore.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PrismStore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Windows 10 Store Solid Palette -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppAccent" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="AppHeaderBg" Color="{ThemeResource SystemAltHighColor}" />
                    <SolidColorBrush x:Key="AppSidebarBg" Color="{ThemeResource SystemChromeMediumColor}" />
                    <SolidColorBrush x:Key="AppCardBg" Color="{ThemeResource SystemListLowColor}" />
                    <SolidColorBrush x:Key="AppCardBorder" Color="{ThemeResource SystemChromeHighColor}" />
                    <SolidColorBrush x:Key="AppHeroBg" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="AppTagBg" Color="{ThemeResource SystemListMediumColor}" />
                    <SolidColorBrush x:Key="AppTextPrimary" Color="{ThemeResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="AppTextSecondary" Color="{ThemeResource SystemBaseMediumHighColor}" />
                    <SolidColorBrush x:Key="AppTextMuted" Color="{ThemeResource SystemBaseMediumColor}" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppAccent" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="AppHeaderBg" Color="{ThemeResource SystemAltHighColor}" />
                    <SolidColorBrush x:Key="AppSidebarBg" Color="{ThemeResource SystemChromeMediumColor}" />
                    <SolidColorBrush x:Key="AppCardBg" Color="{ThemeResource SystemListLowColor}" />
                    <SolidColorBrush x:Key="AppCardBorder" Color="{ThemeResource SystemChromeHighColor}" />
                    <SolidColorBrush x:Key="AppHeroBg" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="AppTagBg" Color="{ThemeResource SystemListMediumColor}" />
                    <SolidColorBrush x:Key="AppTextPrimary" Color="{ThemeResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="AppTextSecondary" Color="{ThemeResource SystemBaseMediumHighColor}" />
                    <SolidColorBrush x:Key="AppTextMuted" Color="{ThemeResource SystemBaseMediumColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Flat Solid Square App Tile DataTemplate (Fixed Dimensions) -->
            <DataTemplate x:Key="SquareAppTemplate">
                <Grid Width="170" 
                      Height="250"
                      Margin="6" 
                      Background="{ThemeResource AppCardBg}" 
                      BorderBrush="{ThemeResource AppCardBorder}" 
                      BorderThickness="1"
                      Opacity="0"
                      RenderTransformOrigin="0.5,0.5"
                      Loaded="AppTile_Loaded">
                    <Grid.RenderTransform>
                        <CompositeTransform ScaleX="0.8" ScaleY="0.8" />
                    </Grid.RenderTransform>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="140" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 1:1 Aspect Artwork -->
                    <Grid Grid.Row="0" Background="#1A1A1A">
                        <Image Source="{Binding ImagePath}" 
                               Stretch="UniformToFill" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" />
                    </Grid>

                    <!-- Metadata Section -->
                    <Grid Grid.Row="1" Padding="8,6,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding Title}" 
                                   FontFamily="Segoe UI" 
                                   FontWeight="SemiBold" 
                                   FontSize="14" 
                                   Foreground="{ThemeResource AppTextPrimary}" 
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="1"
                                   Text="{Binding Subtitle}" 
                                   FontFamily="Segoe UI" 
                                   FontWeight="Normal" 
                                   FontSize="11" 
                                   Foreground="{ThemeResource AppTextSecondary}" 
                                   TextTrimming="CharacterEllipsis" 
                                   Margin="0,2,0,0" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,4,0,0">
                            <Border Background="{ThemeResource AppTagBg}" Padding="4,1" Margin="0,0,5,0">
                                <TextBlock Text="{Binding Framework}" 
                                           FontFamily="Segoe UI" 
                                           FontWeight="SemiBold" 
                                           FontSize="9" 
                                           Foreground="{ThemeResource AppAccent}" />
                            </Border>
                            <TextBlock Text="{Binding Version}" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Normal" 
                                       FontSize="9" 
                                       Foreground="{ThemeResource AppTextMuted}" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Responsive Breakpoints targeting root SplitView -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <!-- Mobile Screens (< 720px) -->
                <VisualState x:Name="MobileState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootSplitView.DisplayMode" Value="Overlay" />
                        <Setter Target="RootSplitView.IsPaneOpen" Value="False" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Desktop Screens (>= 720px) -->
                <VisualState x:Name="DesktopState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootSplitView.DisplayMode" Value="CompactOverlay" />
                        <Setter Target="RootSplitView.IsPaneOpen" Value="False" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Grid Grid.Row="0" Background="{ThemeResource AppHeaderBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="HamburgerBtn" Grid.Column="0" Width="54" Height="54"
                    Background="Transparent" BorderThickness="0" Click="HamburgerBtn_Click">
                <FontIcon Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource AppTextPrimary}" FontSize="18" />
            </Button>

            <StackPanel Orientation="Horizontal" Grid.Column="1">
                <Image Source="ms-appx:///Assets/PrismStore.png" 
           Width="50" 
           Height="50" 
           VerticalAlignment="Center" 
           Stretch="Uniform" 
           Margin="0,0,0,0"/>
                <TextBlock x:Name="HeaderTitleText"
                       Text="Store" 
                       FontFamily="Segoe UI" 
                       FontWeight="Light" 
                       FontSize="26" 
                       Foreground="{ThemeResource AppTextPrimary}" 
                       VerticalAlignment="Center" 
                       Margin="14,0,0,0" />
            </StackPanel>

            <Button x:Name="RefreshBtn" Grid.Column="2" Width="54" Height="54"
                    Background="Transparent" BorderThickness="0" Click="RefreshBtn_Click">
                <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource AppTextPrimary}" FontSize="18" />
            </Button>
        </Grid>

        <!-- SplitView Navigation Drawer -->
        <SplitView x:Name="RootSplitView" 
                   Grid.Row="1" 
                   CompactPaneLength="54" 
                   OpenPaneLength="260" 
                   DisplayMode="CompactOverlay" 
                   IsPaneOpen="False">

            <SplitView.Pane>
                <Grid x:Name="NavPaneGrid" 
                      Background="{ThemeResource AppSidebarBg}"
                      PointerEntered="NavPaneGrid_PointerEntered" 
                      PointerExited="NavPaneGrid_PointerExited">

                    <ListBox x:Name="NavListBox" 
                             Background="Transparent" 
                             SelectionChanged="NavListBox_SelectionChanged" 
                             Margin="0,12,0,0">
                        <ListBoxItem Tag="Home" IsSelected="True" Height="52" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource AppAccent}" Width="26" FontSize="18"/>
                                <TextBlock Text="Home" FontFamily="Segoe UI" FontWeight="Light" FontSize="16" Foreground="{ThemeResource AppTextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="AllApps" Height="52" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE71D;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource AppAccent}" Width="26" FontSize="18"/>
                                <TextBlock Text="All Apps" FontFamily="Segoe UI" FontWeight="Light" FontSize="16" Foreground="{ThemeResource AppTextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Categories" Height="52" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource AppAccent}" Width="26" FontSize="18"/>
                                <TextBlock Text="Categories" FontFamily="Segoe UI" FontWeight="Light" FontSize="16" Foreground="{ThemeResource AppTextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Downloads" Height="52" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource AppAccent}" Width="26" FontSize="18"/>
                                <TextBlock Text="Downloads" FontFamily="Segoe UI" FontWeight="Light" FontSize="16" Foreground="{ThemeResource AppTextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Uploader" Height="52" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE753;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource AppAccent}" Width="26" FontSize="18"/>
                                <TextBlock Text="Upload App" FontFamily="Segoe UI" FontWeight="Light" FontSize="16" Foreground="{ThemeResource AppTextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Settings" Height="52" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource AppAccent}" Width="26" FontSize="18"/>
                                <TextBlock Text="Settings" FontFamily="Segoe UI" FontWeight="Light" FontSize="16" Foreground="{ThemeResource AppTextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Grid>
            </SplitView.Pane>

            <!-- Store Main Content Area -->
            <SplitView.Content>
                <Grid>
                    <ProgressRing x:Name="LoadingRing" 
                                  IsActive="False" 
                                  Visibility="Collapsed" 
                                  Width="56" 
                                  Height="56" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" 
                                  Foreground="{ThemeResource AppAccent}" />

                    <!-- VIEW 1: HOME STOREFRONT -->
                    <ScrollViewer x:Name="HomeScrollViewer" 
                                  Visibility="Visible" 
                                  Padding="0,0,0,0"
                                  RenderTransformOrigin="0.5,0.5">
                        <ScrollViewer.RenderTransform>
                            <CompositeTransform ScaleX="1" ScaleY="1" />
                        </ScrollViewer.RenderTransform>

                        <StackPanel>
                            <!-- EDGE-TO-EDGE ROTATING SPOTLIGHT BANNER -->
                            <Grid x:Name="SpotlightHeroContainer" 
      Height="280" 
      HorizontalAlignment="Stretch"
      Background="{ThemeResource AppHeroBg}"
      Margin="0,0,0,24"
      Tapped="SpotlightBanner_Tapped">

                                <Image x:Name="SpotlightHeroImage" 
           Stretch="UniformToFill" 
           HorizontalAlignment="Center" 
           VerticalAlignment="Center" 
           Opacity="0.45" />

                                <Grid Background="#40000000" />
                                <Grid>
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.0" />
                                            <GradientStop Color="#CC000000" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                </Grid>

                                <Grid Padding="28,24,28,20">
                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="680">
                                        <Border Background="{ThemeResource AppAccent}" 
                    HorizontalAlignment="Left" 
                    Padding="8,3" 
                    Margin="0,0,0,10">
                                            <TextBlock Text="FEATURED SPOTLIGHT" 
                           FontSize="11" 
                           FontFamily="Segoe UI" 
                           FontWeight="SemiBold" 
                           Foreground="White"/>
                                        </Border>

                                        <TextBlock x:Name="SpotlightTitleText" 
                       Text="Welcome to PrismStore" 
                       FontFamily="Segoe UI" 
                       FontWeight="Light" 
                       FontSize="30" 
                       Foreground="White" 
                       TextTrimming="CharacterEllipsis"/>

                                        <TextBlock x:Name="SpotlightSubtitleText" 
                       Text="Browse top featured apps, Windows 10 UWP packages, and classic software." 
                       FontFamily="Segoe UI" 
                       FontWeight="Normal" 
                       FontSize="14" 
                       Foreground="White" 
                       TextTrimming="CharacterEllipsis" 
                       Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Carousel Navigation Dots -->
                                    <StackPanel x:Name="SpotlightDotsPanel" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    Margin="0,0,8,4"/>
                                </Grid>
                            </Grid>

                            <!-- Home Grid Collections -->
                            <StackPanel Padding="20,0,20,0">
                                <TextBlock Text="Top Apps" 
                                           FontFamily="Segoe UI" 
                                           FontWeight="Light" 
                                           FontSize="26" 
                                           Foreground="{ThemeResource AppTextPrimary}" 
                                           Margin="6,0,0,14"/>

                                <GridView x:Name="TopAppsGridView" 
                                          SelectionMode="None" 
                                          IsItemClickEnabled="True" 
                                          ItemClick="AppItem_Click" 
                                          ItemTemplate="{StaticResource SquareAppTemplate}" 
                                          Margin="0,0,0,32" />

                                <TextBlock Text="Windows 10 Apps" 
                                           FontFamily="Segoe UI" 
                                           FontWeight="Light" 
                                           FontSize="26" 
                                           Foreground="{ThemeResource AppTextPrimary}" 
                                           Margin="6,0,0,14"/>

                                <GridView x:Name="PrismAppsGridView" 
                                          SelectionMode="None" 
                                          IsItemClickEnabled="True" 
                                          ItemClick="AppItem_Click" 
                                          ItemTemplate="{StaticResource SquareAppTemplate}" 
                                          Margin="0,0,0,32" />

                                <TextBlock Text="Windows 8.1 Apps" 
                                           FontFamily="Segoe UI" 
                                           FontWeight="Light" 
                                           FontSize="26" 
                                           Foreground="{ThemeResource AppTextPrimary}" 
                                           Margin="6,0,0,14"/>

                                <GridView x:Name="NeonAppsGridView" 
                                          SelectionMode="None" 
                                          IsItemClickEnabled="True" 
                                          ItemClick="AppItem_Click" 
                                          ItemTemplate="{StaticResource SquareAppTemplate}" 
                                          Margin="0,0,0,32" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- VIEW 2: ALL APPS MASTER GRID -->
                    <Grid x:Name="AllAppsContainer" 
                          Visibility="Collapsed"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <CompositeTransform ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <AutoSuggestBox x:Name="SearchFilterBox" 
                                        Grid.Row="0" 
                                        Margin="24,16,24,10" 
                                        Height="38" 
                                        FontFamily="Segoe UI" 
                                        FontWeight="Light" 
                                        FontSize="15" 
                                        PlaceholderText="Search apps and packages..." 
                                        QueryIcon="Find" 
                                        TextChanged="SearchFilterBox_TextChanged"/>

                        <GridView x:Name="AllAppsGridView" 
                                  Grid.Row="1" 
                                  Padding="20,10,20,40" 
                                  SelectionMode="None" 
                                  IsItemClickEnabled="True" 
                                  ItemClick="AppItem_Click" 
                                  ItemTemplate="{StaticResource SquareAppTemplate}" />
                    </Grid>

                    <!-- VIEW 3: CATEGORIES CONTAINER -->
                    <Grid x:Name="CategoriesContainer" 
                          Visibility="Collapsed" 
                          Padding="24,16,24,40"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <CompositeTransform ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="6,0,0,16">
                            <TextBlock Text="Categories" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Light" 
                                       FontSize="28" 
                                       Foreground="{ThemeResource AppTextPrimary}" />
                            <TextBlock x:Name="CategorySubheaderText" 
                                       Text="Browse apps and games by category." 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Light" 
                                       FontSize="13" 
                                       Foreground="{ThemeResource AppTextMuted}" 
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="6,0,0,20">
                            <ComboBox x:Name="CategoryComboBox" 
                                      Header="Category"
                                      MinWidth="240"
                                      FontFamily="Segoe UI" 
                                      FontWeight="Light"
                                      FontSize="14"
                                      SelectionChanged="CategoryComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontWeight="Normal" />
                                            <TextBlock Text="{Binding CountText}" FontFamily="Segoe UI" Foreground="{ThemeResource AppTextMuted}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <GridView x:Name="CategoryAppsGridView" 
                                      SelectionMode="None" 
                                      IsItemClickEnabled="True" 
                                      ItemClick="AppItem_Click" 
                                      ItemTemplate="{StaticResource SquareAppTemplate}" />

                            <StackPanel x:Name="CategoryEmptyStateText" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center" 
                                        Visibility="Collapsed" 
                                        Margin="0,40,0,0">
                                <FontIcon Glyph="&#xE71D;" 
                                          FontFamily="Segoe MDL2 Assets" 
                                          FontSize="42" 
                                          Foreground="{ThemeResource AppTextMuted}" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,0,0,12" />
                                <TextBlock Text="No apps found in this category" 
                                           FontFamily="Segoe UI" 
                                           FontWeight="Light" 
                                           FontSize="18" 
                                           Foreground="{ThemeResource AppTextPrimary}" 
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Check back later for newly added packages." 
                                           FontFamily="Segoe UI" 
                                           FontWeight="Light" 
                                           FontSize="13" 
                                           Foreground="{ThemeResource AppTextMuted}" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- VIEW 4: DOWNLOADS CONTAINER -->
                    <Grid x:Name="DownloadsContainer" 
                          Visibility="Collapsed" 
                          Padding="32,24,32,40"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <CompositeTransform ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Downloads" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Light" 
                                       FontSize="28" 
                                       Foreground="{ThemeResource AppTextPrimary}" 
                                       Margin="0,0,0,6" />

                            <TextBlock Text="Your recent downloads and installation history appear here." 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Light" 
                                       FontSize="14" 
                                       Foreground="{ThemeResource AppTextSecondary}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
                            <Button x:Name="ClearDownloadsHistoryButton" 
                                    Content="Clear history" 
                                    Background="{ThemeResource AppCardBg}" 
                                    BorderBrush="{ThemeResource AppCardBorder}" 
                                    BorderThickness="1" 
                                    Padding="16,6" 
                                    Click="ClearDownloadsHistory_Click" />
                        </StackPanel>

                        <Grid Grid.Row="2" MaxWidth="900" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                            <ListView x:Name="DownloadsHistoryListView" 
                                      SelectionMode="None" 
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollMode="Auto">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource AppCardBg}" 
                                                BorderBrush="{ThemeResource AppCardBorder}" 
                                                BorderThickness="1" 
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Width="48" Height="48" Background="#1A1A1A">
                                                    <FontIcon Glyph="&#xE896;" 
                                                              FontFamily="Segoe MDL2 Assets" 
                                                              FontSize="22" 
                                                              Foreground="{ThemeResource AppTextMuted}" 
                                                              HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center" />
                                                    <Image Source="{Binding ImagePath}" 
                                                           Width="48" 
                                                           Height="48" 
                                                           Stretch="UniformToFill" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                                </Grid>

                                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" 
                                                               FontFamily="Segoe UI" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="15" 
                                                               Foreground="{ThemeResource AppTextPrimary}" />
                                                    <TextBlock Text="{Binding FileName}" 
                                                               FontFamily="Segoe UI" 
                                                               FontSize="12" 
                                                               Foreground="{ThemeResource AppTextSecondary}" 
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding DownloadedAt}" 
                                                               FontFamily="Segoe UI" 
                                                               FontSize="11" 
                                                               Foreground="{ThemeResource AppTextMuted}" 
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty State Notice -->
                            <Border x:Name="EmptyDownloadsPanel" 
                                    Background="{ThemeResource AppCardBg}" 
                                    BorderBrush="{ThemeResource AppCardBorder}" 
                                    BorderThickness="1" 
                                    Padding="32" 
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{ThemeResource AppTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="No downloads yet" FontFamily="Segoe UI" FontWeight="Light" FontSize="18" Foreground="{ThemeResource AppTextPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Items downloaded from the store will appear here." FontFamily="Segoe UI" FontWeight="Light" FontSize="13" Foreground="{ThemeResource AppTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- VIEW 6: UPLOADER CONTAINER -->
                    <ScrollViewer x:Name="UploaderContainer" 
                                  Visibility="Collapsed" 
                                  Padding="32,24,32,40"
                                  RenderTransformOrigin="0.5,0.5">
                        <ScrollViewer.RenderTransform>
                            <CompositeTransform ScaleX="1" ScaleY="1" />
                        </ScrollViewer.RenderTransform>
                        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                            <TextBlock Text="App Uploader" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Light" 
                                       FontSize="28" 
                                       Foreground="{ThemeResource AppTextPrimary}" 
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Submit your applications and packages to the catalog." 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Light" 
                                       FontSize="14" 
                                       Foreground="{ThemeResource AppTextSecondary}" 
                                       Margin="0,0,0,24" />

                            <!-- Unauthenticated Banner -->
                            <Border x:Name="UploaderAuthRequiredPanel" 
                                    Background="{ThemeResource AppCardBg}" 
                                    BorderBrush="{ThemeResource AppCardBorder}" 
                                    BorderThickness="1" 
                                    Padding="24" 
                                    Margin="0,0,0,24"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="SIGN IN REQUIRED" 
                                               FontFamily="Segoe UI Light" 
                                               FontSize="24" 
                                               Foreground="{ThemeResource AppTextPrimary}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Please sign in from the Settings account section to access the submission portal." 
                                               FontFamily="Segoe UI" 
                                               FontSize="14" 
                                               Foreground="{ThemeResource AppTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Submission Form Panel (Stacked Vertically) -->
                            <StackPanel x:Name="UploaderSubmissionFormPanel">
                                <TextBox x:Name="UploaderTitleBox" Header="Application Title" PlaceholderText="e.g. My Awesome App" MaxLength="100" Margin="0,0,0,14"/>
                                <TextBox x:Name="UploaderSubtitleBox" Header="Subtitle" PlaceholderText="Short summary" MaxLength="200" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14"/>
                                <TextBox x:Name="UploaderCategoryBox" Header="Category" PlaceholderText="e.g. Utilities, Games, Media" MaxLength="100" Margin="0,0,0,14"/>
                                <TextBox x:Name="UploaderPublisherBox" Header="Publisher" PlaceholderText="e.g. Geek Devs" MaxLength="100" Margin="0,0,0,14"/>
                                <TextBox x:Name="UploaderVersionBox" Header="Version" PlaceholderText="e.g. 1.0.0" MaxLength="50" Margin="0,0,0,14"/>
                                <TextBox x:Name="UploaderFrameworkBox" Header="Framework / Target OS" PlaceholderText="e.g. UWP, WinUI 3" MaxLength="100" Margin="0,0,0,14"/>

                                <TextBox x:Name="UploaderIconUrlBox" Header="Icon Image URL" PlaceholderText="https://..." Margin="0,0,0,14"/>
                                <TextBox x:Name="UploaderScreenshotUrlBox" Header="Screenshot Image URL" PlaceholderText="https://..." Margin="0,0,0,14"/>
                                <TextBox x:Name="UploaderDownloadUrlBox" Header="Download URL" PlaceholderText="https://..." Margin="0,0,0,14"/>

                                <TextBox x:Name="UploaderDescriptionBox" Header="Description" AcceptsReturn="True" TextWrapping="Wrap" Height="120" PlaceholderText="Full app details..." MaxLength="5000" Margin="0,0,0,20"/>

                                <Button x:Name="UploaderSubmitButton"
                                        Content="Submit Application"
                                        Width="220" 
                                        Background="{ThemeResource AppAccent}" 
                                        Foreground="White"
                                        BorderThickness="0"
                                        Height="40"
                                        HorizontalAlignment="Right">
                                    <Button.Flyout>
                                        <Flyout x:Name="UploaderSubmitConfirmFlyout">
                                            <StackPanel Width="280">
                                                <TextBlock Text="Submit Application?" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <TextBlock Text="Are you sure you want to submit this app for review? Please ensure all URLs and details are correct." TextWrapping="Wrap" Margin="0,0,0,16"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="Yes, Submit" HorizontalAlignment="Stretch" Click="UploaderConfirmSubmit_Click"/>
                                                    <Button Grid.Column="2" Content="Cancel" HorizontalAlignment="Stretch" Click="UploaderCancelSubmit_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- VIEW 5: INTEGRATED SETTINGS (Account, Updates, About & Credits) -->
                    <ScrollViewer x:Name="SettingsContainer" 
                                  Visibility="Collapsed" 
                                  Padding="32,24,32,40"
                                  RenderTransformOrigin="0.5,0.5">
                        <ScrollViewer.RenderTransform>
                            <CompositeTransform ScaleX="1" ScaleY="1" />
                        </ScrollViewer.RenderTransform>
                        <StackPanel MaxWidth="850" HorizontalAlignment="Left">
                            <TextBlock Text="Settings" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Light" 
                                       FontSize="28" 
                                       Foreground="{ThemeResource AppTextPrimary}" 
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Manage your store account, client updates, and application details." 
                                       FontFamily="Segoe UI" 
                                       FontWeight="Light" 
                                       FontSize="14" 
                                       Foreground="{ThemeResource AppTextSecondary}" 
                                       Margin="0,0,0,24" />

                            <!-- SECTION 1: ACCOUNT -->
                            <TextBlock Text="Account" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="SemiBold" 
                                       FontSize="18" 
                                       Foreground="{ThemeResource AppTextPrimary}" 
                                       Margin="0,0,0,10" />

                            <!-- Logged In Panel -->
                            <Border x:Name="LoggedInProfilePanel" 
                                    Background="{ThemeResource AppCardBg}" 
                                    BorderBrush="{ThemeResource AppCardBorder}" 
                                    BorderThickness="1" 
                                    Padding="24" 
                                    Margin="0,0,0,24"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="AccountUsernameText" 
                                               Text="Logged in as User" 
                                               FontFamily="Segoe UI" 
                                               FontWeight="SemiBold" 
                                               FontSize="20" 
                                               Foreground="{ThemeResource AppTextPrimary}" />

                                    <TextBlock x:Name="SessionExpiryStatusText" 
                                               Text="Session expires in: --:--" 
                                               FontFamily="Segoe UI" 
                                               FontWeight="Light" 
                                               FontSize="13" 
                                               Foreground="{ThemeResource AppTextMuted}" 
                                               Margin="0,4,0,16" />

                                    <Button Content="Sign Out" 
                                            Background="#991B1B" 
                                            Foreground="White" 
                                            FontFamily="Segoe UI" 
                                            FontWeight="Light" 
                                            Padding="20,6" 
                                            BorderThickness="0" 
                                            Click="SignOut_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Logged Out Auth Pivot -->
                            <StackPanel x:Name="LoggedOutAuthPanel" Margin="0,0,0,24">
                                <Pivot>
                                    <PivotItem Header="Sign In">
                                        <Border Background="{ThemeResource AppCardBg}" 
                                                BorderBrush="{ThemeResource AppCardBorder}" 
                                                BorderThickness="1" 
                                                Padding="24" 
                                                Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBox x:Name="LoginUsernameBox" Header="Username" Margin="0,0,0,14" />
                                                <PasswordBox x:Name="LoginPasswordBox" Header="Password" Margin="0,0,0,20" />
                                                <Button Content="Sign In" 
                                                        Background="{ThemeResource AppAccent}" 
                                                        Foreground="White" 
                                                        FontFamily="Segoe UI" 
                                                        FontWeight="Light" 
                                                        Padding="24,7" 
                                                        BorderThickness="0" 
                                                        Click="LoginButton_Click" />
                                            </StackPanel>
                                        </Border>
                                    </PivotItem>

                                    <PivotItem Header="Create Account">
                                        <Border Background="{ThemeResource AppCardBg}" 
                                                BorderBrush="{ThemeResource AppCardBorder}" 
                                                BorderThickness="1" 
                                                Padding="24" 
                                                Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBox x:Name="RegEmailBox" Header="Email" Margin="0,0,0,14" />
                                                <TextBox x:Name="RegUsernameBox" Header="Username" Margin="0,0,0,14" />
                                                <PasswordBox x:Name="RegPasswordBox" Header="Password" Margin="0,0,0,14" />
                                                <PasswordBox x:Name="RegConfirmPasswordBox" Header="Confirm Password" Margin="0,0,0,20" />
                                                <Button Content="Register Account" 
                                                        Background="{ThemeResource AppAccent}" 
                                                        Foreground="White" 
                                                        FontFamily="Segoe UI" 
                                                        FontWeight="Light" 
                                                        Padding="24,7" 
                                                        BorderThickness="0" 
                                                        Click="RegisterButton_Click" />
                                            </StackPanel>
                                        </Border>
                                    </PivotItem>
                                </Pivot>
                            </StackPanel>

                            <!-- SECTION 2: UPDATES -->
                            <TextBlock Text="Updates" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="SemiBold" 
                                       FontSize="18" 
                                       Foreground="{ThemeResource AppTextPrimary}" 
                                       Margin="0,10,0,10" />

                            <Border Background="{ThemeResource AppCardBg}" 
                                    BorderBrush="{ThemeResource AppCardBorder}" 
                                    BorderThickness="1" 
                                    Padding="22" 
                                    Margin="0,0,0,24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="PrismStore Client" 
                                                   FontFamily="Segoe UI" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="16" 
                                                   Foreground="{ThemeResource AppTextPrimary}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <ProgressRing x:Name="UpdateProgressRing" 
                                                          Width="18" 
                                                          Height="18" 
                                                          IsActive="False" 
                                                          Visibility="Collapsed" 
                                                          Foreground="{ThemeResource AppAccent}" 
                                                          Margin="0,0,10,0" />

                                            <TextBlock x:Name="UpdateStatusText" 
                                                       Text="Ready to check for updates." 
                                                       FontFamily="Segoe UI" 
                                                       FontWeight="Light" 
                                                       FontSize="13" 
                                                       Foreground="{ThemeResource AppTextMuted}" 
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button x:Name="CheckUpdatesButton" 
                                            Grid.Column="1" 
                                            Content="Check for updates" 
                                            Background="{ThemeResource AppAccent}" 
                                            Foreground="White" 
                                            FontFamily="Segoe UI" 
                                            FontWeight="Light" 
                                            Padding="18,7" 
                                            BorderThickness="0" 
                                            Click="CheckUpdatesButton_Click" />
                                </Grid>
                            </Border>

                            <!-- SECTION 3: ABOUT -->
                            <TextBlock Text="About" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="SemiBold" 
                                       FontSize="18" 
                                       Foreground="{ThemeResource AppTextPrimary}" 
                                       Margin="0,10,0,10" />

                            <Border Background="{ThemeResource AppCardBg}" 
                                    BorderBrush="{ThemeResource AppCardBorder}" 
                                    BorderThickness="1" 
                                    Padding="24" 
                                    Margin="0,0,0,24">
                                <StackPanel>
                                    <!-- App Logo Image -->
                                    <Image Source="ms-appx:///Assets/PrismStore.png" 
                                           Width="96" 
                                           Height="96" 
                                           HorizontalAlignment="Left" 
                                           Stretch="Uniform" 
                                           Margin="0,0,0,16"/>

                                    <TextBlock Text="PrismStore (version 1.0.26240.2)" 
                                               FontFamily="Segoe UI" 
                                               FontWeight="Bold" 
                                               FontSize="16" 
                                               Foreground="{ThemeResource AppTextPrimary}"/>

                                    <TextBlock Text="By using this program, you agree to Geek Devs Comm: REIMP (GDCR)'s rules, terms, guidelines and regulations." 
                                               FontFamily="Segoe UI" 
                                               FontSize="14" 
                                               Foreground="{ThemeResource AppTextSecondary}" 
                                               TextWrapping="Wrap" 
                                               Margin="0,10,0,16"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Discord Server" 
                                                Background="{ThemeResource AppAccent}" 
                                                Foreground="White" 
                                                Padding="18,6" 
                                                BorderThickness="0" 
                                                Margin="0,0,12,0" 
                                                Click="Discord_Click"/>
                                        <Button Content="Website" 
                                                Background="{ThemeResource AppAccent}" 
                                                Foreground="White" 
                                                Padding="18,6" 
                                                BorderThickness="0" 
                                                Click="Website_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 4: CREDITS -->
                            <TextBlock Text="Credits" 
                                       FontFamily="Segoe UI" 
                                       FontWeight="SemiBold" 
                                       FontSize="18" 
                                       Foreground="{ThemeResource AppTextPrimary}" 
                                       Margin="0,10,0,10" />

                            <Border Background="{ThemeResource AppCardBg}" 
                                    BorderBrush="{ThemeResource AppCardBorder}" 
                                    BorderThickness="1" 
                                    Padding="24">
                                <StackPanel>
                                    <TextBlock Text="Made by Andrew Shepherd Simson" 
                                               FontFamily="Segoe UI" 
                                               FontSize="16" 
                                               FontStyle="Italic" 
                                               FontWeight="SemiBold" 
                                               Foreground="{ThemeResource AppTextPrimary}" 
                                               Margin="0,0,0,14" />

                                    <TextBlock Text="• Account and reviews system by Andrew" 
                                               FontFamily="Segoe UI" 
                                               FontSize="13" 
                                               FontStyle="Italic" 
                                               Foreground="{ThemeResource AppTextSecondary}" 
                                               Margin="0,0,0,6" />

                                    <TextBlock Text="• Server hosting by Dank" 
                                               FontFamily="Segoe UI" 
                                               FontSize="13" 
                                               FontStyle="Italic" 
                                               Foreground="{ThemeResource AppTextSecondary}" 
                                               Margin="0,0,0,6" />

                                    <TextBlock Text="• Previous GeekHub/NanoStore database by Jack, Alex, and shuckkkers" 
                                               FontFamily="Segoe UI" 
                                               FontSize="13" 
                                               FontStyle="Italic" 
                                               Foreground="{ThemeResource AppTextSecondary}" 
                                               Margin="0,0,0,6" />

                                    <TextBlock Text="• All GDCR developers who submitted their apps in CommProj" 
                                               FontFamily="Segoe UI" 
                                               FontSize="13" 
                                               FontStyle="Italic" 
                                               Foreground="{ThemeResource AppTextSecondary}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>
